TPU_SKIP_MDS_QUERY=1
XLA_PYTHON_CLIENT_PREALLOCATE=false
TCMALLOC_AGGRESSIVE_DECOMMIT=true
NPROC=2
LIBTPU_INIT_ARGS=--xla_tpu_enable_diagnostic_coordinator=false --tpu_hbm_report_enable=false --enable_runtime_uptime_telemetry=false --xla_tpu_dvfs_p_state=7
TMPDIR=/dev/shm
VLLM_USE_RUST_FRONTEND=1
VLLM_ENGINE_READY_TIMEOUT_S=7200
VLLM_EXECUTE_MODEL_TIMEOUT_SECONDS=10800
VLLM_HTTP_TIMEOUT_KEEP_ALIVE=120
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
PYTHONHASHSEED=0
TPU_USE_RAIDEN_KV_CACHE_MANAGER=1
TPU_RAIDEN_KIMIK3_ADMISSION=1
TPU_KV_RESHARD_TRANSPORT=raiden
TPU_RAIDEN_RESHARD_IMPL=store
TPU_RAIDEN_PREFIX_AWARE_LOAD=1
TPU_RAIDEN_TRANSFER_PARALLELISM=32
TPU_RAIDEN_DST_SHARDS=32
TPU_RAIDEN_TRANSFER_NUM_SLOTS=1
TPU_RAIDEN_POOL_STAGING_LEASES=16
TPU_P2P_WAIT_PULL_TIMEOUT=900
RAIDEN_NUMA_POLICY=bind
RAIDEN_EXPECTED_WORKERS_TIMEOUT_S=1800
